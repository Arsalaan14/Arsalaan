# MediQueryNow deployment configuration
# Copy to .env and change JWT_SECRET/passwords before any public deployment.
LLM_PROVIDER=offline
JWT_SECRET=replace-with-a-long-random-secret
APP_PORT=8080
CORS_ORIGINS=*
ADMIN_PASSWORD=Admin@123
PROVIDER_PASSWORD=Provider@123
PATIENT_PASSWORD=Patient@123
INSURER_PASSWORD=Insurer@123

# Optional AWS Bedrock
# LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.meta.llama3-3-70b-instruct-v1:0

# Optional LM Studio
# LLM_PROVIDER=lmstudio
# LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
# LM_STUDIO_MODEL_NAME=your-model
